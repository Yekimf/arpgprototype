{
  "name": "ashen-reliquary",
  "version": "0.12.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build --base=./ && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:standalone": "npm run build && node --test tests/standalone.test.mjs",
    "art:pack": "node scripts/pack-art.mjs && node scripts/pack-guard.mjs && node scripts/pack-lines.mjs && node scripts/pack-world-bounds.mjs && node scripts/pack-armor.mjs && node scripts/pack-menu.mjs && node scripts/pack-quests.mjs",
    "profile": "node scripts/profile-browser.mjs",
    "art:guard": "node scripts/pack-guard.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "sharp": "^0.35.5",
    "vite": "^7.1.0"
  }
}
